{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizzle-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "api.occitangames.com", "custom_domain": true },
    { "pattern": "admin.occitangames.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizzle",
      "database_id": "6f634034-a656-40ba-a90c-6f5d37860ff8",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 8 * * *"] },
  "observability": { "enabled": true }
}
